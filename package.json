{
  "name": "card-god-of-war",
  "version": "0.2.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && VITE_DEV_SERVER_URL=http://localhost:5173 npx electron .\"",
    "build": "vue-tsc --noEmit && esbuild src/main.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/main/main.js --format=cjs && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "pinia": "^3.0.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "sass": "^1.85.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^3.1.0",
    "vue-tsc": "^2.2.0",
    "wait-on": "^9.0.10"
  }
}
